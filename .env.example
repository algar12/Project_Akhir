# Konfigurasi Jaringan & Interface
CAPTURE_INTERFACE=eth0
IOT_SUBNET=192.168.20.0/24
GATEWAY_IP=192.168.20.1

# Konfigurasi MQTT Broker
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_BASE=iot/#

# Konfigurasi Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=network_guard
DB_USER=guard_user
DB_PASSWORD=guard_secret

# Konfigurasi Suricata
SURICATA_EVE_PATH=/var/log/suricata/eve.json

# Konfigurasi Model Anomaly Detection
MODEL_PATH=ml/models/isolation_forest.pkl
ANOMALY_CONTAMINATION=0.05

# Konfigurasi Collector
TRAFFIC_BATCH_SIZE=50
TRAFFIC_FLUSH_INTERVAL=5
LOG_LEVEL=INFO

# Konfigurasi Detection Engine — Threshold
PORTSCAN_PKT_THRESHOLD=20
PORTSCAN_WINDOW_SECONDS=5
SYNFLOOD_PKT_THRESHOLD=100
SYNFLOOD_WINDOW_SECONDS=2
ICMPFLOOD_PKT_THRESHOLD=50
ICMPFLOOD_WINDOW_SECONDS=3
# TRAFFIC_SPIKE: total bytes dalam window TRAFFIC_SPIKE_WINDOW detik.
# Nilai aktif = 5000000 (5 MB / 5 dtk ≈ 1 MB/s) agar browsing/download normal
# aman; flood DoS sungguhan tetap terdeteksi.
TRAFFIC_SPIKE_BPS=5000000
TRAFFIC_SPIKE_WINDOW=5
MQTT_RATE_THRESHOLD=30
MQTT_RATE_WINDOW=1

# Alert suppression — alert duplikat (IP+jenis sama) diabaikan selama N detik
ALERT_SUPPRESS_SECONDS=30

# Suricata EVE polling interval (detik)
EVE_POLL_INTERVAL=1.0

# Konfigurasi ML — Isolation Forest
IF_N_ESTIMATORS=200
# IF_SCORE_THRESHOLD: kosongkan (default) agar memakai threshold hasil kalibrasi
# training (if_calibration.json). Hanya diisi untuk tuning manual.
# IF_SCORE_THRESHOLD=-0.05
FEATURE_WINDOW_SECONDS=10

# Konfigurasi ML — Random Forest
RF_N_ESTIMATORS=150
RF_MAX_DEPTH=15

# Konfigurasi Predictor Real-Time
PREDICTOR_POLL_INTERVAL=10

# ─── Konfigurasi API Server ───────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# API Key — WAJIB diisi sebelum deploy! Generate dengan:
#   python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=GANTI_DENGAN_KEY_AMAN_MINIMAL_32_KARAKTER

# CORS — origin yang diizinkan (pisahkan koma)
CORS_ORIGINS=http://localhost:3000,http://192.168.20.100:3000

# Rate Limiting (format: N/period — period: second/minute/hour)
RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_HEAVY=30/minute

# Paginasi
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=500

# WebSocket polling interval (detik)
WS_POLL_INTERVAL=2.0
